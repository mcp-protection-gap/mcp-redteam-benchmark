# Phase 1 collectors
GITHUB_TOKEN=ghp_xxx                # required for code-search at >10 req/min
SMITHERY_API_KEY=                   # optional; HTML scrape fallback
GLAMA_API_KEY=
PULSEMCP_API_KEY=
COMPOSIO_API_KEY=

# Sandbox
DOCKER_HOST=                        # leave empty to use local socket
SANDBOX_IMAGE=cym500/mcp-sandbox:latest
SANDBOX_NETWORK_MODE=none           # or "bridge" if a server legitimately needs egress

# Storage
DATA_ROOT=./data
LOG_LEVEL=INFO

# Responsible disclosure
DISCLOSURE_TRACKER=./data/disclosure-tracker.csv
GITHUB_SECRET_SCANNING_TOKEN=       # optional: programmatic alert submission
